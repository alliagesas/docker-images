OWNCLOUD_VERSION=10.16 # Numéro de version d'Owncloud
OWNCLOUD_DOMAIN=cloud.pingat.com # Nom de domaine principal (ou sous-domaine)
OWNCLOUD_TRUSTED_DOMAINS=localhost,docker2.pingat.lan,cloud.pingat.com # Liste des domaines ou sous-domaines où Owncloud répond
OWNCLOUD_DB_NAME=owncloud # Nom de la base de données
OWNCLOUD_DB_USERNAME=oc_admin # Utilisateur Mysql
OWNCLOUD_DB_PASSWORD=oc_admin # Mot de passe de l'utilisateur Mysql ci-dessus
ADMIN_USERNAME=admin # Login de l'administrateur dans l'application
ADMIN_PASSWORD=admin # Mot de passe de l'administrateur ci-dessus
HTTP_PORT=80 # NE PAS MODIFIER